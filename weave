#!/usr/bin/env python3
"""Run Weave straight from a checkout, without installing the package.

    ./weave run examples/todo.weave
"""
from __future__ import annotations

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from the_weave.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
